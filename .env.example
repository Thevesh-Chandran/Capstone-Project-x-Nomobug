# Paths only. Never paste credential JSON, tokens, API keys, or source IDs here.
NOMOBUG_GOOGLE_CLIENT_SECRET=C:\secure\nomobug_google_oauth_client.json
NOMOBUG_GOOGLE_TOKEN=C:\secure\nomobug_google_token.json
NOMOBUG_GOOGLE_SOURCE_IDS=C:\secure\nomobug_google_source_ids.json

# BigQuery primary warehouse. Fill project/region after confirming console settings.
# Use Application Default Credentials; keep Sheets/Calendar OAuth separate.
NOMOBUG_BQ_PROJECT=
NOMOBUG_BQ_LOCATION=
NOMOBUG_BQ_UPLOAD_APPROVED=no
NOMOBUG_WAREHOUSE=bigquery
# Retain DATABASE_URL in your private .env for the Neon fallback; never commit it.

# Optional private Geoapify pilot key. Put the real value only in .env (git-ignored).
NOMOBUG_GEOAPIFY_API_KEY=
