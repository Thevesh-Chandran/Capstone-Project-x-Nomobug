FROM python:3.14-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
COPY deploy/requirements-planning.txt ./
RUN pip install --no-cache-dir -r requirements-planning.txt \
    && useradd --uid 10004 --create-home --shell /usr/sbin/nologin planner
COPY scripts/cp2_planning_job.py scripts/planning_engine.py scripts/load_calendar_bronze.py /app/scripts/
COPY webapp/storage.py webapp/planning.py /app/webapp/
COPY webapp/models/planning_v1.json /app/webapp/models/
COPY config/cp2_planning_v1.json config/cp2_planning_festivals.json /app/config/
USER 10004:10004
CMD ["python", "-m", "scripts.cp2_planning_job"]
